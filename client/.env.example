# Client env (Vite). Copy to client/.env.local and fill in.

# Server API base (defaults to http://localhost:8787 for local dev)
# VITE_API_URL=http://localhost:8787

# thirdweb client id — enables wallet sign-in (email + browser wallet).
# Get one free at https://thirdweb.com/dashboard (Settings → API Keys → Client ID).
# Without it the app still runs; wallet buttons show a "set this to enable" hint.
# VITE_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# On-chain game token (Base Sepolia). Defaults to the deployed PTEST address in code;
# override to point the client at a different token contract.
# VITE_TOKEN_ADDRESS=0x63EF99E736080519b2D8171FEa2bb3346a4Debd7

# Deployed PlayerNFT (Base Sepolia). Defaults in code; override to repoint.
# VITE_NFT_ADDRESS=0x6E66DDF087d79281f16Df49aA36E3DC0d4330D55

# ScoutNFT (Base Sepolia) — set after deploy to enable scout minting.
# VITE_SCOUT_ADDRESS=0x...
