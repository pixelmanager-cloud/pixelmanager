node_modules/
dist/
*.log
docs/agents/STOP
.DS_Store

# on-server agent runtime files (never commit these)
agent/.env
agent/.runstate
agent/last-report.txt
agent/verify.log
agent/STOP

# server dev database
server/*.db
server/*.db-*

# overnight bot harness run artifacts
bots/bot-run.db
bots/bot-run.db-*
bots/*.log
bots/bugs.jsonl

# overnight code-agent session logs
docs/agents/logs/
.claude/worktrees/

# Retro Diffusion API key (never commit)
tools/.rd_key
.rd_key

# Rendered trailer masters — 60-90MB each and re-encoded on every tweak, which would bloat history fast.
# The whole film is reproducible from the committed pipeline: see store/steam/trailer/README.md.
store/steam/trailer/*.mp4
store/steam/trailer/*.webm

# fal.ai key — same rule as the Retro Diffusion key: never committed
tools/.fal_key
.fal_key

# The rendered trailer score — derived from the licensed OGGs by tools/trailer/score.mjs
store/steam/trailer/*.wav
store/steam/trailer/*.m4a

# Audit agents render the stylesheet by copying index.html somewhere a browser can load it. Two ~200KB
# copies reached client/public — which Vite ships verbatim — and a third reached the repo root. None of
# them is referenced by anything, so nothing had a reason to notice. Kept out by name, and by
# tools/playtest/ship_hygiene.ts for the shipped tree.
client/public/*.html
__*probe*.html
_probe*.html
*_probe.html
