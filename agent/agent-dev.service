[Unit]
Description=Pixel Manager on-server dev agent (one task per run)
After=network-online.target
Wants=network-online.target

# Install as a per-user unit (~/.config/systemd/user/). Do NOT add a User= line —
# a --user service already runs as that user, and User= makes it fail 216/GROUP.
# %h auto-expands to the user's home under `systemctl --user`.
[Service]
Type=oneshot
WorkingDirectory=%h/pixelmanager
# Secrets live here (chmod 600), NOT in the repo. See agent/setup-vultr.md.
EnvironmentFile=%h/pixelmanager/agent/.env
ExecStart=/usr/bin/env bash %h/pixelmanager/agent/run.sh
# Bound a single run so a stuck task can't run forever (raised so content tasks aren't cut short).
TimeoutStartSec=3600
