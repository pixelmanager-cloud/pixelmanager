{
  "name": "football-manager",
  "private": true,
  "workspaces": ["shared", "client"],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "test:engine": "tsx shared/strategy_test.ts",
    "fuzz": "tsx shared/fuzz_test.ts",
    "verify": "npm run build --workspace=client && npm run test:engine && npm run fuzz && tsx shared/career_sim.ts && tsx client/qa_savestore.ts && tsx client/qa_offline_facade.ts",
    "qa": "node scripts/run-qa.mjs",
    "playtest": "tsx tools/playtest/analyze_player_career.ts 400 && tsx tools/playtest/analyze_manager_career.ts 300 15"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
